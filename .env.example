# Copy to .env.local and fill in. Never commit .env.local.

# Customer Supabase project URL (read only by server code)
NEXT_PUBLIC_SUPABASE_URL=
# Unused: ticket inserts go through a server action with the service-role client
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Postgres connection string of the same Customer project; used only by the unsafe Breaker-OFF path
CUSTOMER_DATABASE_URL=
# Trifecta Breaker HTTP API
BREAKER_URL=http://localhost:4000
# Server-only. Not needed when using the scripted fallback
ANTHROPIC_API_KEY=
